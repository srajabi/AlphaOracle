################################################################################
# EXAMPLE FILE - DO NOT PUT REAL KEYS HERE
#
# This is a TEMPLATE showing the required environment variables.
#
# TO USE:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Edit .env (NOT this file) with your actual keys
# 3. .env is gitignored and must never be committed
#
# Anything you write in THIS file WILL be committed to git.
################################################################################

################################################################################
# LLM API keys
################################################################################
# These are FALLBACK CHAINS, not alternatives - see the routing section below.
# Chain order is the drain order: the first entry is called every run until it
# stops answering, then the next takes over. Put the balance nearest expiry
# first, so prepaid credit is spent before it lapses.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GLM_API_KEY=your_glm_api_key_here

################################################################################
# LLM model routing
################################################################################
# Comma-separated fallback chains, tried left to right until one answers. Any
# provider-side failure falls through - insufficient balance, expired key, rate
# limit and outage are indistinguishable from the call site.
#
# NOTE: the variable is PM_MODELS (plural). PM_MODEL singular is the old
# single-model form and no longer provides a fallback path.
RISK_MODELS=deepseek/deepseek-v4-flash,gemini/gemini-2.5-flash,anthropic/claude-haiku-4-5
TECH_MODELS=deepseek/deepseek-v4-flash,gemini/gemini-2.5-flash,anthropic/claude-haiku-4-5
MACRO_MODELS=deepseek/deepseek-v4-flash,gemini/gemini-2.5-flash,anthropic/claude-haiku-4-5
PM_MODELS=deepseek/deepseek-v4-pro,anthropic/claude-sonnet-5,gemini/gemini-2.5-flash

# Set MOCK_LLM=true to run the pipeline with canned responses and no API calls.
# MOCK_LLM=true

################################################################################
# Macro data - FRED / ALFRED
################################################################################
# ONE key serves both. FRED is the current-vintage view, ALFRED the
# point-in-time archive; same credential, same api.stlouisfed.org host.
#
# Only needed for VINTAGE (point-in-time) queries. The keyless bulk download in
# tools/download_fred_history.py works without it.
#
# Vintages matter: released macro data is revised for years, so backtesting a
# 2008 decision against today's PAYEMS feeds it numbers that did not exist
# until 2010 - lookahead bias living inside the data, where the causality
# tests cannot see it.
FRED_API_KEY=your_fred_api_key_here

################################################################################
# Alpaca - development account
################################################################################
# Local testing and manual runs. Expect junk trades here; that is fine.
ALPACA_DEV_API_KEY=your_alpaca_dev_api_key_here
ALPACA_DEV_SECRET_KEY=your_alpaca_dev_secret_key_here

################################################################################
# Alpaca - production paper accounts
################################################################################
# Scheduled runs only. One strategy per account.

# Account 1: LLM recommendations
ALPACA_PROD_1_NAME=llm_recommendations
ALPACA_PROD_1_API_KEY=your_alpaca_account_1_api_key_here
ALPACA_PROD_1_SECRET_KEY=your_alpaca_account_1_secret_key_here

# Account 2: Reddit 200 SMA on TQQQ
ALPACA_PROD_2_NAME=reddit_200sma_tqqq
ALPACA_PROD_2_API_KEY=your_alpaca_account_2_api_key_here
ALPACA_PROD_2_SECRET_KEY=your_alpaca_account_2_secret_key_here

# Account 3: Dual momentum (SPY/QQQ/GLD rotation)
ALPACA_PROD_3_NAME=dual_momentum
ALPACA_PROD_3_API_KEY=your_alpaca_account_3_api_key_here
ALPACA_PROD_3_SECRET_KEY=your_alpaca_account_3_secret_key_here

# Account 4: Sector rotation
ALPACA_PROD_4_NAME=sector_rotation
ALPACA_PROD_4_API_KEY=your_alpaca_account_4_api_key_here
ALPACA_PROD_4_SECRET_KEY=your_alpaca_account_4_secret_key_here

# Account 5: Mean reversion
ALPACA_PROD_5_NAME=mean_reversion
ALPACA_PROD_5_API_KEY=your_alpaca_account_5_api_key_here
ALPACA_PROD_5_SECRET_KEY=your_alpaca_account_5_secret_key_here

################################################################################
# Alerting - delivery
################################################################################
# Both channels are free. Alerting works without them; only DELIVERY is
# disabled, so the state machine still runs and records transitions.
#
# Email: use a DEDICATED Gmail account, not your primary. A Google App
# Password authenticates for Mail, which includes IMAP READ access, and it
# bypasses 2FA - so a leaked App Password on your main account is read access
# to your whole inbox.
MAIL_TO=where_alerts_should_arrive@example.com
MAIL_USERNAME=dedicated_sender@gmail.com
MAIL_PASSWORD=your_16_char_google_app_password
# MAIL_SERVER=smtp.gmail.com

# Telegram: @BotFather -> /newbot -> token. Message the bot once (bots cannot
# initiate), then read chat.id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

################################################################################
# Alerting - dead-man's switch
################################################################################
# The in-workflow heartbeat cannot detect its own absence: if Actions stops
# firing entirely, no heartbeat is sent and the silence looks like calm. An
# external watcher is the only thing that catches that.
# healthchecks.io free tier; period ~1 day, grace ~6h.
HEALTHCHECK_URL=https://hc-ping.com/your-uuid-here

################################################################################
# Local paths
################################################################################
# Root of the 1-minute OHLCV archive. Only needed for minute-data work; the
# archive-dependent tests skip cleanly when it is absent.
# OHLCV_1M_ROOT=E:\ColdStorage\OHLCV-1m\data

################################################################################
# REMINDER: never put real keys in this file. Edit .env instead.
################################################################################
